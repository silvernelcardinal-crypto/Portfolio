# Copy this file to ".env" and fill in your key. The .env file is NEVER committed
# to Git (see .gitignore). Vercel does NOT use this file — set the variable in
# Vercel → Settings → Environment Variables instead.
#
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-PASTE-YOUR-KEY-HERE

# Optional: force one specific model. Without this, the server tries several
# free models in order and remembers the one that answers.
# OPENROUTER_MODEL=openrouter/free
